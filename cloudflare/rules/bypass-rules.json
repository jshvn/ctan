{
  "name": "default",
  "description": "sha256:STAMP",
  "kind": "zone",
  "phase": "http_request_cache_settings",
  "rules": [
    {
      "description": "cache off: every request reads the bucket",
      "expression": "(http.host eq \"@HOST@\")",
      "action": "set_cache_settings",
      "action_parameters": {"cache": false}
    }
  ]
}
