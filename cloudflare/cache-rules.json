{
  "name": "default",
  "description": "sha256:STAMP",
  "kind": "zone",
  "phase": "http_request_cache_settings",
  "rules": [
    {
      "description": "cache on: one day at the edge; 3xx and up never stored, so an added key needs no purge",
      "expression": "(http.host eq \"@HOST@\")",
      "action": "set_cache_settings",
      "action_parameters": {
        "cache": true,
        "edge_ttl": {
          "mode": "override_origin",
          "default": 86400,
          "status_code_ttl": [{"status_code_range": {"from": 300, "to": 599}, "value": -1}]
        }
      }
    }
  ]
}
