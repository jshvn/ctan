{
  "name": "default",
  "description": "sha256:STAMP",
  "kind": "zone",
  "phase": "http_request_dynamic_redirect",
  "rules": [
    {
      "description": "directory URLs: R2 has no listings, so send them to CTAN's own page for that directory",
      "expression": "(ends_with(http.request.uri.path, \"/\") and http.request.uri.path ne \"/\")",
      "action": "redirect",
      "action_parameters": {
        "from_value": {
          "status_code": 302,
          "target_url": {"expression": "concat(\"https://ctan.org/tex-archive\", http.request.uri.path)"},
          "preserve_query_string": false
        }
      }
    }
  ]
}
